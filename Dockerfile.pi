FROM debian:bookworm-slim

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN groupadd --gid "$HOST_GID" sandbox \
  && useradd --uid "$HOST_UID" --gid sandbox --shell /bin/bash --create-home sandbox

ENV APT_DEPENDENCIES="bash ca-certificates curl wget git ripgrep \
        jq file tree xxd bsdextrautils \
        zip unzip xz-utils bzip2 zstd \
        procps lsof \
        make patch less \
        clang mold pkg-config libx11-dev libxkbcommon-dev libwayland-dev \
        libudev-dev libudev1 libasound2-dev"

RUN apt-get update \
  && apt-get install -y --no-install-recommends $APT_DEPENDENCIES \
  && apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false \
  && rm -rf /var/lib/apt/lists/*

### Sandboxing commands
COPY sandbox-command /usr/local/bin/sandbox-command

RUN chmod +x /usr/local/bin/sandbox-command \
  && for cmd in sudo su apt apt-get dpkg systemctl service shutdown reboot; do \
       ln -sf sandbox-command "/usr/local/bin/$cmd"; \
     done

### Sandbox entrypoint
COPY entrypoint.sh /usr/local/bin/pi-sandbox-entrypoint

RUN chmod +x /usr/local/bin/pi-sandbox-entrypoint

### Environment setup

ENV HOME=/home/sandbox \
    USER=sandbox \
    LOGNAME=sandbox \
    SHELL=/bin/bash

ENV CARGO_HOME=$HOME/.cargo \
    RUSTUP_HOME=$HOME/.rustup \
    PATH="$HOME/.local/bin:$HOME/.cargo/bin:${PATH}"

# /etc/profile resets PATH, hiding the mise-managed tools (node, npx, npm,
# python3, pi) in login shells. Re-activate mise for them.
RUN printf '%s\n' \
      'if [ -x "$HOME/.local/bin/mise" ]; then' \
      '  eval "$("$HOME/.local/bin/mise" activate bash 2>/dev/null)"' \
      'fi' \
      > /etc/profile.d/mise.sh \
  && chmod 644 /etc/profile.d/mise.sh

USER sandbox

### Rust toolchain

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      -o /tmp/rustup-init.sh \
  && sh /tmp/rustup-init.sh -y --profile default --default-toolchain stable \
  && rm /tmp/rustup-init.sh

RUN mkdir -p $CARGO_HOME \
  && printf '%s\n' \
    "[target.'cfg(target_os = \"linux\")']" \
    'linker = "clang"' \
    'rustflags = ["-C", "link-arg=-fuse-ld=mold"]' \
    > $CARGO_HOME/config.toml

# Cargo cache (mounted at /cache by the pi script).
RUN ln -s /cache/cargo/registry $CARGO_HOME/registry \
  && ln -s /cache/cargo/git $CARGO_HOME/git

### Mise

RUN curl --proto '=https' --tlsv1.2 -fsSL https://mise.run \
      -o /tmp/mise-install.sh \
      && sh /tmp/mise-install.sh \
      && rm /tmp/mise-install.sh \
      && mise use --global python@3.15 \
      && mise use --global node@24 \
      && mise use --global fd@10.5.2

WORKDIR /workspace

## Install pi coding agent

RUN mise exec -- npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
    && mise exec -- pi --version

## Install agent skills into ~/.agents/skills (the user-level Pi skills path)

RUN mise exec -- npx --yes skills add https://github.com/warpdotdev/common-skills \
      --skill resolve-merge-conflicts -g -a pi -y \
    && mise exec -- npx --yes skills add https://github.com/mattpocock/skills \
      --skill tdd -g -a pi -y \
    && test -f "$HOME/.agents/skills/resolve-merge-conflicts/SKILL.md" \
    && test -f "$HOME/.agents/skills/tdd/SKILL.md" \
    && rm -rf "$HOME/.npm/_npx"

## The upstream skill uses repo-relative `.agents/skills/...` paths; since this
## is a global install, point its commands at the user-level copy instead.

RUN sed -i \
      's#\.agents/skills/resolve-merge-conflicts/scripts/extract_conflict_context\.py#~/.agents/skills/resolve-merge-conflicts/scripts/extract_conflict_context.py#g' \
      "$HOME/.agents/skills/resolve-merge-conflicts/SKILL.md" \
    && ! grep -q 'python3 \.agents/skills/' "$HOME/.agents/skills/resolve-merge-conflicts/SKILL.md"

## Global gitignore for all repositories in the sandbox

RUN mkdir -p /home/sandbox/.config/git

COPY --chown=sandbox:sandbox global.gitignore /home/sandbox/.config/git/ignore

RUN git config --global core.excludesFile /home/sandbox/.config/git/ignore

ENTRYPOINT ["/usr/local/bin/pi-sandbox-entrypoint"]
