#!/usr/bin/env bash
set -euo pipefail

sandbox_home=/home/sandbox

usage() {
  cat <<'EOF'
Usage: pi [--shell] [args...]

Runs the pi coding agent in the sandbox container.

Options:
  --shell    run /bin/bash in the container instead of pi, for testing
             purposes. It is deliberately not a login shell, because
             /etc/profile resets PATH and would hide the mise-managed tools
             (node, npx, npm, python3, pi); extra args are passed to bash, e.g.
             `pi --shell -c 'cargo build --target x86_64-pc-windows-gnu'`.
  -h, --help show this help.

Environment:
  SANDBOX_CMD  command to run in the container instead of `pi`
               (e.g. SANDBOX_CMD=bash). --shell takes precedence.
EOF
}

# Command executed inside the container (ENTRYPOINT is `mise exec --`).
command=(pi)

case ${1:-} in
  -h | --help)
    usage
    exit 0
    ;;
  --shell)
    shift
    command=(/bin/bash)
    ;;
  "")
    ;;
esac

if [[ -n ${SANDBOX_CMD:-} && ${command[0]} == pi ]]; then
  read -r -a command <<<"$SANDBOX_CMD"
fi

project_dir="$(pwd -P)"
folder="${project_dir##*/}"
container_dir="/workspace/${folder:-root}"

mounts=()

# add_mount <source> <target> [ro]
# Skips sources that do not exist, since bind mounts fail on a missing source.
add_mount() {
  local src=$1 dest=$2 flags=

  case ${3:-} in
    "") ;;
    ro) flags=,readonly ;;
    *)
      echo "add_mount: invalid mode '$3' for '$2' (expected 'ro')" >&2
      return 1
      ;;
  esac

  [[ -e "$src" ]] || return 0

  # Bind mount sources must be absolute and free of symlinks.
  src="$(realpath "$src")"

  mounts+=(--mount "type=bind,source=$src,target=$dest$flags")
}

add_mount "$project_dir" "$container_dir"
add_mount "$project_dir/.git" "$container_dir/.git" ro

host_cargo_home="${CARGO_HOME:-$HOME/.cargo}"

if [[ -d "$host_cargo_home" ]]; then
  mkdir -p "$host_cargo_home/registry" "$host_cargo_home/git"

  add_mount "$host_cargo_home/registry" "$sandbox_home/.cargo/registry"
  add_mount "$host_cargo_home/git" "$sandbox_home/.cargo/git"
fi

add_mount "${NPM_CONFIG_CACHE:-$HOME/.npm}" "$sandbox_home/.npm"
add_mount "${AGENTS_SKILLS_DIR:-$HOME/.agents/skills}" "$sandbox_home/.agents/skills" ro

exec docker run --rm -it \
  "${mounts[@]}" \
  --pull never \
  -v pi-agent-home:$sandbox_home/.pi/agent \
  --env USER=sandbox \
  --workdir "$container_dir" \
  pi-sandbox "${command[@]}" "$@"
